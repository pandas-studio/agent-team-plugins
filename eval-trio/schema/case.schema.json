{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pandas-studio/agent-team-plugins/eval-trio/schema/case.schema.json",
  "title": "Eval Trio case v1",
  "type": "object",
  "required": ["schema_version", "preset", "task", "criteria", "submission"],
  "properties": {
    "schema_version": {"const": 1},
    "preset": {"enum": ["generic", "bug-fix"]},
    "task": {"type": "string"},
    "criteria": {"type": "string"},
    "submission": {
      "oneOf": [
        {"type": "object", "required": ["kind", "repo", "base", "head"],
         "properties": {"kind": {"const": "git"}, "repo": {"type": "string"},
                        "base": {"type": "string"}, "head": {"type": "string"}},
         "additionalProperties": false},
        {"type": "object", "required": ["kind", "path"],
         "properties": {"kind": {"enum": ["directory", "file"]}, "path": {"type": "string"}},
         "additionalProperties": false}
      ]
    },
    "checks": {"type": "array", "maxItems": 32, "items": {
      "type": "object", "required": ["argv"],
      "properties": {
        "id": {"type": "string"}, "baseline": {"type": "boolean"},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 300},
        "expected_base": {"type": "object", "required": ["rc"], "properties": {
          "rc": {"type": "array", "minItems": 1, "items": {"type": "integer", "not": {"const": 0}}},
          "stdout_regex": {"type": "string"}, "stderr_regex": {"type": "string"}
        }, "additionalProperties": false},
        "files": {"type": "array", "items": {"type": "object", "required": ["source", "target"],
                  "properties": {"source": {"type": "string"}, "target": {"type": "string"}},
                  "additionalProperties": false}}
      }, "additionalProperties": false
    }}
  },
  "additionalProperties": false
}
