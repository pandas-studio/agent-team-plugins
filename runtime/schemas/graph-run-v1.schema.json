{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pandas-studio.github.io/agent-team-plugins/graph-run-v1.schema.json",
  "title": "Agent Team Graph Run v1",
  "type": "object",
  "required": ["schema_version", "thread_id", "run_id", "project_id", "status", "allowed_paths"],
  "properties": {
    "schema_version": {"const": "graph-run-v1"},
    "thread_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,47}$"},
    "status": {"enum": ["running", "approved", "rejected", "needs-human"]},
    "attempt": {"type": "integer", "minimum": 0, "maximum": 5},
    "allowed_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "artifacts": {"type": "array"},
    "usage": {"type": "array"}
  },
  "additionalProperties": true
}
