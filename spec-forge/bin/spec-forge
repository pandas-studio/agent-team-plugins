#!/usr/bin/env bash
# spec-forge — draft-a-spec helper (RFC 0005). Subcommands: gate, lint.
set -uo pipefail
SPEC_FORGE_ROOT="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
# shellcheck source=../lib/common.sh
. "$SPEC_FORGE_ROOT/lib/common.sh"
# shellcheck source=../lib/plugin-deps.sh
. "$SPEC_FORGE_ROOT/lib/plugin-deps.sh"
# shellcheck source=../lib/gate.sh
. "$SPEC_FORGE_ROOT/lib/gate.sh"
# shellcheck source=../lib/lint.sh
. "$SPEC_FORGE_ROOT/lib/lint.sh"

usage() {
  cat <<'USAGE'
Usage: spec-forge <command> [options]

Commands:
  gate   check a confirmed design-decision record and open a run directory
  lint   check a run directory's spec.md, BACKLOG.md and report.md

Run `spec-forge <command> --help` for a command's options.
USAGE
}

cmd="${1:-}"
case "$cmd" in
  gate) shift; sf_gate "$@"; exit $? ;;
  lint) shift; sf_lint "$@"; exit $? ;;
  -h|--help) usage; exit 0 ;;
  '') usage >&2; exit "$SF_RC_USAGE" ;;
  *) sf_err "unknown command: $cmd"; usage >&2; exit "$SF_RC_USAGE" ;;
esac
