<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ralph overnight launchd template for macOS.
  Generate the installed plist with the renderer documented in the README.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.user.ralph</string>

  <key>ProgramArguments</key>
  <array>
    <string>{{RALPH_SOLO_BIN}}</string>
    <string>--max-iter</string>
    <string>50</string>
    <string>--max-runtime</string>
    <string>6h</string>
    <string>--worktree</string>
    <string>--prompt</string>
    <string>{{REPO}}/PROMPT.md</string>
    <string>--test-cmd</string>
    <string>{{TEST_CMD}}</string>
  </array>

  <key>RunAtLoad</key>
  <false/>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>23</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>WorkingDirectory</key>
  <string>{{REPO}}</string>

  <key>StandardOutPath</key>
  <string>{{REPO}}/.ralph-trio/log/overnight/launchd.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>{{REPO}}/.ralph-trio/log/overnight/launchd.stderr.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>AGENT_TEAM</key>
    <string>overnight</string>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
